# Copy this file to ".env" (same folder as index.php) and fill in what you need.
# .env is blocked from the web by .htaccess — never commit it or put keys in site.json.

# --- where enquiries are emailed (reservations, party enquiries, private feedback) ---
OWNER_EMAIL=
# Optional: the From address (use an address on your own domain so mail isn't flagged as spam)
MAIL_FROM=

# --- "Ask Aroma" AI concierge + Mood-to-Meal personalisation (optional; the site works without it) ---
# AI_PROVIDER: anthropic | openai  ("openai" works with any OpenAI-compatible endpoint via AI_BASE_URL)
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-haiku-5-5
# Only for openai-compatible providers, e.g. https://api.openai.com/v1
AI_BASE_URL=

# --- live Google reviews (Places API (New)) ---
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# random text, makes the rate-limit file names unguessable
APP_SALT=change-me
