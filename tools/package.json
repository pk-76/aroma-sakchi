{
  "name": "aroma-tools",
  "private": true,
  "type": "module",
  "description": "Build-time tooling for the Aroma Multicuisine site (image pipeline, vendor copy, OCR helper). Not needed on the production server.",
  "scripts": {
    "images": "node build-images.mjs",
    "vendor": "node copy-vendor.mjs",
    "ocr": "node ocr-menu.mjs",
    "assets": "node build-assets.mjs",
    "logo": "node build-logo.mjs",
    "build": "node copy-vendor.mjs && node build-images.mjs && node build-logo.mjs && node build-assets.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/noto-sans-devanagari": "^5.3.0",
    "@fontsource/noto-serif-devanagari": "^5.3.0",
    "esbuild": "^0.28.2",
    "gsap": "^3.15.1",
    "jspdf": "^4.2.1",
    "lenis": "^1.3.27",
    "page-flip": "^2.0.7",
    "sharp": "^0.35.5",
    "swiper": "^14.4.0"
  }
}
